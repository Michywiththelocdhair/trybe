# ────────────────────────────────────────────────────────────
# Trybe website — environment variables
# Copy to .env.local for local dev. Set these in Vercel for prod.
# ────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Create a project at https://supabase.com and copy keys from
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (transactional + marketing email) ────────────────
# Create at https://resend.com. Verify the trybe.uk domain
# before sending from hello@trybe.uk.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Trybe <hello@trybe.uk>"
RESEND_AUDIENCE_ID=

# ── Stripe (Studio Stars tickets, £100 / £80) ───────────────
# Use test keys in dev, live keys in prod. Add webhook secret
# from Stripe dashboard → Webhooks after creating the endpoint.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://trybe.uk

# ── Booking + ops ───────────────────────────────────────────
# How long a pending_payment booking holds its seats for before
# the expire-bookings cron releases them. The Server Action
# clamps the real hold up to Stripe's 30-minute minimum when
# creating the Checkout Session, so a shorter value here just
# means the DB record expires sooner on your side.
BOOKING_HOLD_MINUTES=15

# Version string snapshotted on every booking in the
# `terms_version` column, for audit if your terms change.
TERMS_VERSION=v1-2026-10

# Shared secret the Vercel Cron sends in Authorization: Bearer
# to /api/cron/expire-bookings. Generate with: openssl rand -hex 32
CRON_SECRET=
